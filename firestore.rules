rules_version = '2';

/**
 * Firestore Security Rules for QueueEase
 * 
 * Purpose: Protect organization data, appointments, queues, and user profiles
 * with role-based access control (RBAC) and data validation.
 * 
 * Collections:
 * - users: User profiles with PII protection
 * - organizations: Organization data owned by admin users
 *   - services (subcollection): Services offered by organizations
 *   - working_hours (subcollection): Organization operating hours
 *   - appointments (subcollection): Customer appointments
 *   - queues (subcollection): Queue entries for walk-in customers
 * 
 * Roles:
 * - admin: Can manage own organization and its subcollections
 * - customer: Can read organization data, create appointments/queues for self
 * 
 * Created: 2026-02-25
 * Feature: 001-firestore-security-rules
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================================
    // HELPER FUNCTIONS
    // =============================================================================
    
    /**
     * Check if user is authenticated
     * @returns true if request has valid authentication
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /**
     * Get the role of the authenticated user from their user document
     * @returns user role string ('admin' or 'customer') or null if not found
     */
    function getUserRole() {
      return isAuthenticated() 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    
    /**
     * Check if the authenticated user has admin role
     * @returns true if user role is 'admin'
     */
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    /**
     * Check if the authenticated user owns the specified organization
     * @param orgId - Organization document ID to check ownership
     * @returns true if user is admin and owns the organization
     */
    function ownsOrganization(orgId) {
      return isAuthenticated() 
        && isAdmin() 
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUid == request.auth.uid;
    }
    
    /**
     * Validate that a value is one of the allowed enum values
     * @param value - Value to validate
     * @param allowedValues - List of allowed enum values
     * @returns true if value is in allowedValues list
     */
    function isValidEnum(value, allowedValues) {
      return value in allowedValues;
    }
    
    /**
     * Validate that incoming document has all required fields
     * @param required - List of required field names
     * @returns true if all required fields are present in request.resource.data
     */
    function hasRequiredFields(required) {
      return request.resource.data.keys().hasAll(required);
    }
    
    /**
     * Validate that incoming document only contains allowed fields (no unexpected fields)
     * @param allowedFields - List of allowed field names
     * @returns true if all fields in request.resource.data are in allowedFields list
     */
    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    /**
     * Ensure `createdAt` is not modified on updates
     */
    function createdAtNotModified() {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']));
    }

    /**
     * Validate that an appointment status transition is permitted.
     * Allowed transitions:
     *   booked   -> inQueue   (queue generation)
     *   inQueue  -> serving   (admin starts service)
     *   inQueue  -> noShow    (manual or auto no-show after deadline)
     *   serving  -> completed (admin marks next/done)
     *   serving  -> inQueue   (admin skips; reinserts at end)
     *   noShow   -> inQueue   (admin rejoins no-show entry)
     */
    function isValidStatusTransition(from, to) {
      return (from == 'booked'  && to == 'inQueue')
          || (from == 'inQueue' && to == 'serving')
          || (from == 'inQueue' && to == 'noShow')
          || (from == 'serving' && to == 'completed')
          || (from == 'serving' && to == 'inQueue')
          || (from == 'noShow'  && to == 'inQueue');
    }
    
    // =============================================================================
    // COLLECTION RULES
    // =============================================================================
    
    // -------------------------------------------------------------------------
    // ORGANIZATIONS COLLECTION (User Story 1)
    // -------------------------------------------------------------------------
    match /organizations/{orgId} {
      // T029: Anyone authenticated can read organization data (public info for booking)
      allow read: if isAuthenticated();
      
      // T030: Admin can create organization with matching adminUid
      allow create: if isAuthenticated()
        && isAdmin()
        && request.resource.data.adminUid == request.auth.uid
        // Required fields and types
        && request.resource.data.keys().hasAll(['adminUid','name','bookingLinkSlug','isOpen','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.bookingLinkSlug is string
        && request.resource.data.bookingLinkSlug.size() <= 50
        && request.resource.data.isOpen is bool
        && request.resource.data.createdAt is timestamp
        // Only allowed fields
        && hasOnlyAllowedFields(['adminUid','name','bookingLinkSlug','isOpen','description','address','phoneNumber','email','qrCodeUrl','logoUrl','createdAt','updatedAt']);
      
      // T031: Only organization owner can update/delete
      allow update: if isAuthenticated()
        && ownsOrganization(orgId)
        // createdAt must be immutable and adminUid cannot change
        && createdAtNotModified()
        && request.resource.data.adminUid == resource.data.adminUid
        && hasOnlyAllowedFields(['adminUid','name','bookingLinkSlug','isOpen','description','address','phoneNumber','email','qrCodeUrl','logoUrl','createdAt','updatedAt']);

      allow delete: if isAuthenticated() && ownsOrganization(orgId);
      
      // -------------------------------------------------------------------------
      // SERVICES SUBCOLLECTION (User Story 1)
      // -------------------------------------------------------------------------
      match /services/{serviceId} {
        // T032: Anyone authenticated can read services (public catalog)
        allow read: if isAuthenticated();
        
        // T033: Only organization owner can create services with validation
        allow create: if isAuthenticated()
          && ownsOrganization(orgId)
          && request.resource.data.keys().hasAll(['orgId','name','durationMinutes','timeMarginMinutes','isActive','createdAt'])
          && request.resource.data.orgId == orgId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 5
          && request.resource.data.durationMinutes <= 480
          && request.resource.data.timeMarginMinutes is int
          && request.resource.data.timeMarginMinutes >= 0
          && request.resource.data.timeMarginMinutes <= 60
          && request.resource.data.isActive is bool
          && request.resource.data.createdAt is timestamp
          && hasOnlyAllowedFields(['orgId','name','durationMinutes','timeMarginMinutes','price','description','queueType','isActive','createdAt','updatedAt']);

        allow update: if isAuthenticated()
          && ownsOrganization(orgId)
          && createdAtNotModified()
          && request.resource.data.orgId == resource.data.orgId
          && hasOnlyAllowedFields(['orgId','name','durationMinutes','timeMarginMinutes','price','description','queueType','isActive','createdAt','updatedAt']);

        allow delete: if isAuthenticated() && ownsOrganization(orgId);
      }
      
      // -------------------------------------------------------------------------
      // WORKING HOURS SUBCOLLECTION (User Story 1)
      // -------------------------------------------------------------------------
      match /working_hours/{dayOfWeek} {
        // T034: Anyone authenticated can read working hours (public info)
        allow read: if isAuthenticated();
        
        // T035: Only organization owner can write, with dayOfWeek validation
        allow create: if isAuthenticated()
          && ownsOrganization(orgId)
          && int(dayOfWeek) >= 0
          && int(dayOfWeek) <= 6
          && request.resource.data.dayOfWeek == int(dayOfWeek)
          && request.resource.data.keys().hasAll(['orgId','dayOfWeek','isOpen','createdAt'])
          && request.resource.data.orgId == orgId
          && request.resource.data.dayOfWeek is int
          && request.resource.data.isOpen is bool
          && request.resource.data.createdAt is timestamp
          // If open, require times in HH:mm format
          && (request.resource.data.isOpen == false || (
            request.resource.data.keys().hasAll(['openTime','closeTime'])
            && request.resource.data.openTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.closeTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
          ))
          && (!request.resource.data.keys().hasAny(['breakStart']) || request.resource.data.breakStart == null || request.resource.data.breakStart.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))
          && (!request.resource.data.keys().hasAny(['breakEnd']) || request.resource.data.breakEnd == null || request.resource.data.breakEnd.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))
          && hasOnlyAllowedFields(['orgId','dayOfWeek','isOpen','openTime','closeTime','breakStart','breakEnd','createdAt','updatedAt']);

        allow update: if isAuthenticated()
          && ownsOrganization(orgId)
          && request.resource.data.orgId == orgId
          && request.resource.data.dayOfWeek == resource.data.dayOfWeek
          && createdAtNotModified()
          // If open, re-enforce HH:mm time format on update
          && (request.resource.data.isOpen == false || (
            request.resource.data.keys().hasAll(['openTime','closeTime'])
            && request.resource.data.openTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.closeTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
          ))
          && (!request.resource.data.keys().hasAny(['breakStart']) || request.resource.data.breakStart == null || request.resource.data.breakStart.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))
          && (!request.resource.data.keys().hasAny(['breakEnd']) || request.resource.data.breakEnd == null || request.resource.data.breakEnd.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))
          && hasOnlyAllowedFields(['orgId','dayOfWeek','isOpen','openTime','closeTime','breakStart','breakEnd','createdAt','updatedAt']);

        allow delete: if isAuthenticated() && ownsOrganization(orgId);
      }
      
      // -------------------------------------------------------------------------
      // APPOINTMENTS SUBCOLLECTION (User Story 2 - Phase 4)
      // -------------------------------------------------------------------------
      match /appointments/{appointmentId} {
        // T049: Customer can get own appointment OR organization owner can get any
        // NOTE: Split get/list because resource.data is unavailable during list queries
        allow get: if isAuthenticated()
          && (request.auth.uid == resource.data.customerId
              || ownsOrganization(orgId));

        // T049-list: Any authenticated user can list appointments (needed for slot conflict check)
        allow list: if isAuthenticated();
        
        // T050: Customer can create appointment with matching customerId and validation
        allow create: if isAuthenticated()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.orgId == orgId
          && request.resource.data.keys().hasAll(['orgId','customerId','serviceId','scheduledAt','status','createdAt'])
          && request.resource.data.orgId == orgId
          && request.resource.data.customerId is string
          && request.resource.data.serviceId is string
          && request.resource.data.scheduledAt is timestamp
          // Customers may only create appointments with status 'booked'
          && request.resource.data.status == 'booked'
          && request.resource.data.createdAt is timestamp
          // scheduledAt must be in the future
          && request.resource.data.scheduledAt > request.time
          && hasOnlyAllowedFields(['orgId','customerId','serviceId','customerName','customerPhone','queuePosition','scheduledAt','status','customerNotes','adminNotes','createdAt','updatedAt']);

        // T051: Only organization owner can update/delete appointments; createdAt immutable
        allow update: if isAuthenticated()
          && ownsOrganization(orgId)
          && createdAtNotModified()
          // Immutable identity fields must not change
          && request.resource.data.orgId == orgId
          && resource.data.orgId == request.resource.data.orgId
          && resource.data.customerId == request.resource.data.customerId
          && resource.data.serviceId == request.resource.data.serviceId
          // Re-validate core field types on update
          && request.resource.data.customerId is string
          && request.resource.data.serviceId is string
          && request.resource.data.scheduledAt is timestamp
          // Re-validate status enum and enforce permitted transitions
          && request.resource.data.status in ['booked','inQueue','serving','completed','noShow']
          && isValidStatusTransition(resource.data.status, request.resource.data.status)
          && hasOnlyAllowedFields(['orgId','customerId','serviceId','customerName','customerPhone','queuePosition','scheduledAt','status','customerNotes','adminNotes','createdAt','updatedAt']);

        allow delete: if isAuthenticated() && ownsOrganization(orgId);
      }
      
      // -------------------------------------------------------------------------
      // QUEUES SUBCOLLECTION — daily queue document (Sprint 5)
      // Document ID: yyyy-MM-dd  |  One document per org per day
      // -------------------------------------------------------------------------
      match /queues/{queueDate} {
        // Any authenticated user may read a single queue document.
        // The document contains only appointment IDs — no customer PII —
        // so broad read access is safe and required for customer position lookups.
        allow get: if isAuthenticated();

        // Only org owner may list all queue documents (admin queue history).
        allow list: if isAuthenticated() && ownsOrganization(orgId);

        // Only org owner may generate (create) today's queue document.
        allow create: if isAuthenticated()
          && ownsOrganization(orgId)
          && hasRequiredFields(['orgId','date','orderedAppointmentIds','currentServingIndex','status','generatedAt'])
          && request.resource.data.orgId == orgId
          && request.resource.data.date == queueDate
          && request.resource.data.orderedAppointmentIds is list
          && request.resource.data.currentServingIndex is int
          && request.resource.data.currentServingIndex >= 0
          && request.resource.data.status in ['active','paused','closed']
          && request.resource.data.generatedAt is timestamp
          && hasOnlyAllowedFields(['orgId','date','orderedAppointmentIds','currentServingIndex','status','generatedAt','updatedAt']);

        // Only org owner may apply queue actions (advance, skip, no-show, rejoin).
        allow update: if isAuthenticated()
          && ownsOrganization(orgId)
          && request.resource.data.orgId == orgId
          && request.resource.data.orderedAppointmentIds is list
          && request.resource.data.currentServingIndex is int
          && request.resource.data.currentServingIndex >= 0
          && request.resource.data.status in ['active','paused','closed']
          && hasOnlyAllowedFields(['orgId','date','orderedAppointmentIds','currentServingIndex','status','generatedAt','updatedAt']);

        allow delete: if isAuthenticated() && ownsOrganization(orgId);
      }
    }
    
    // -------------------------------------------------------------------------
    // USERS COLLECTION (User Story 3 - Phase 5)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // T063: User can only read their own document (PII protection)
      allow read: if isAuthenticated()
        && request.auth.uid == userId;
      
      // T064: User can create own document on first-time sign-up
      // Must match document ID and have valid uid field
      // T093: Role must be 'admin' or 'customer' only
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role is string
        && request.resource.data.role in ['admin', 'customer']
        // Required fields and type checks
        && hasRequiredFields(['uid', 'email', 'role'])
        && request.resource.data.email is string
        // Reject unexpected fields
        && hasOnlyAllowedFields(['uid','email','displayName','role','phone','organizationId','tutorialCompleted','createdAt','updatedAt']);
      
      // T065: User can only update their own document
      // Immutable fields (uid, createdAt, role) cannot be modified
      // Role is immutable after creation to prevent privilege escalation
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && createdAtNotModified()
        // Role is immutable - prevents self-escalation (e.g., customer → admin)
        && request.resource.data.role == resource.data.role
        && hasOnlyAllowedFields(['uid','email','displayName','role','phone','organizationId','tutorialCompleted','createdAt','updatedAt']);
      
      // T066: No one can delete user documents (soft delete via update instead)
      allow delete: if false;
    }
    
    // Default deny all access (fail-safe)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // COLLECTION GROUP — cross-org appointment reads (Phase 8, T046)
    //
    // Required for collectionGroup('appointments') used by
    // watchTodayActiveAppointments to power the customer dashboard.
    // Customers may list only documents where customerId matches their UID.
    // -------------------------------------------------------------------------
    match /{path=**}/appointments/{appointmentId} {
      allow list: if isAuthenticated()
        && resource.data.customerId == request.auth.uid;
    }
  }
}
